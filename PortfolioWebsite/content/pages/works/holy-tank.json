    {
      "type": "HighDensityInfoBlock",
      "props": {
        "phase2Items": [],
        "phase1Items": [],
        "id": "holytank-info-1",
        "phase1Title": "项目背景",
        "phase1Subtitle": "Context",
        "phase1Content": "敌意建筑充斥在日常公共空间，它们在维持秩序的同时，也给城市添上了一层尖锐和冷漠的质感。我们想通过游戏探讨：这些设计是否真的让城市变得更安全，还是仅仅让弱势群体更难生存。",
        "phase2Title": "核心创新",
        "phase2Subtitle": "Innovation",
        "phase2Content": "轨迹球原生映射鼠标输入，手握原地旋转的操作方式天然对应轮椅遥杆体感。操作本身的阻力与不便，和角色身体残障形成通感，让玩家切身体会敌意建筑对行动不便者的影响。",
        "phase3Title": "我的贡献",
        "phase3Subtitle": "My Role",
        "phase3Content": "负责主题设定、交互实现和整体系统设计。轨迹球与轮椅操作的映射采用原生方案，没有额外物理参数调整，轨迹球本身的阻力就是叙事。同时负责将敌意建筑概念转化为具体的关卡障碍和空间设计。",
        "phase3ImageSrc": "",
        "phase1Label": "Phase 01",
        "phase2Label": "Phase 02",
        "phase3Label": "Phase 03"
      }
