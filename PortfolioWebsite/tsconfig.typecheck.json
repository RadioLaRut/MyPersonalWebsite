{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.pnpm-backup",
    ".next/types/app/**",
    ".next-dev-*",
    ".next.pre-next16",
    ".next.failed-*"
  ]
}
